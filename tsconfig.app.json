{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "resolveJsonModule": true
  },
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  // src/worker is a different runtime with different globals — it type-checks
  // separately against tsconfig.worker.json and workers-types. Leaving it in
  // here makes the app project fail on `Fetcher` and `ExportedHandler`.
  "exclude": ["src/**/__tests__/*", "src/worker/**"]
}
